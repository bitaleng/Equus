# ============================================================
# 입실관리매니저 — 환경변수 예시
# ============================================================
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 값을 입력하세요.
# .env 파일은 절대 Git에 올리지 마세요 (.gitignore에 포함됨).
#
# 매장 구분(빌드타임 VITE_SKIN)은 더 이상 없습니다 — 앱은 단일 공통 빌드이고,
# 매장별 이름/아이콘/설정은 라이선스 키 활성화 시 서버(Netlify Blobs)가 내려줍니다.
# ============================================================

# ──────────────────────────────────────────────────────────
# [A] Netlify Functions용 환경변수 (Netlify 사이트 설정에 등록)
# ──────────────────────────────────────────────────────────

# 매장 프로필 관리자 도구(client/public/store-admin.html)의 인증 키.
# 새 매장을 코드 빌드 없이 등록/수정할 때 X-Admin-Key 헤더로 사용됩니다.
STORE_ADMIN_KEY=

# PWA 설치 시 CCTV 뷰어/원격제어 주소를 받을 비공개 HTTPS 웹훅
# Netlify 배포: Site configuration > Environment variables에 등록
# 권장: 비공개 Discord 채널의 Webhook URL 또는 자체 HTTPS 수신 API
# 주의: VITE_ 접두사를 붙이면 브라우저 번들에 노출되므로 절대 붙이지 마세요.
CCTV_NOTIFY_URL=

# ──────────────────────────────────────────────────────────
# [B] 서버용 환경변수 (스마트 락커 백엔드 사용 시만 필요)
# ──────────────────────────────────────────────────────────
# ※ 일반 매장 운영(Netlify PWA)에는 아래 변수가 필요 없습니다.
# ※ 스마트 락커 하드웨어 연동을 쓸 때만 설정하세요.

# PostgreSQL 데이터베이스 연결 문자열
# 예: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 스마트 락커 관리자 API 인증 키 (Express 서버 /api/admin/* 전용, Netlify Functions와는 별개)
# 하드웨어 컨트롤러 등록, 기기 관리 API 호출 시 사용
# 개발 환경 기본값: equus-admin-2025 (코드에 하드코딩)
ADMIN_KEY=

# ──────────────────────────────────────────────────────────
# [C] 라이선스 시크릿에 대해
# ──────────────────────────────────────────────────────────
# 라이선스 서명 비밀키는 환경변수가 아니며, 클라이언트 번들에도 없습니다.
# netlify/functions/license-bind.ts(서버)와 client/public/license-generator.html
# (오프라인 관리자 도구)에만 난독화된 형태로 존재합니다.
# → 외부에 공개하거나 Git에 올리면 라이선스 위조 위험이 있습니다.
