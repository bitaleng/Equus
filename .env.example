# ============================================================
# He's / EQUS 입실관리매니저 — 환경변수 예시
# ============================================================
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 값을 입력하세요.
# .env 파일은 절대 Git에 올리지 마세요 (.gitignore에 포함됨).
# ============================================================

# ──────────────────────────────────────────────────────────
# [A] 빌드용 환경변수 (Vite 빌드 시 필요, VITE_ 접두사)
# ──────────────────────────────────────────────────────────

# 스킨 선택: v1 = 에쿠스(EQUS-), v2 = 히즈(HIZZ-)
VITE_SKIN=v2

# 앱 이름 (PWA 설치 시 표시되는 이름)
VITE_APP_NAME=He's 입실관리매니저

# 앱 짧은 이름 (홈 화면 아이콘 아래 표시)
VITE_APP_SHORT_NAME=He's

# 앱 설명 (스플래시 화면 등에 표시)
VITE_APP_DESCRIPTION=라이선스 키를 입력하여 시스템을 활성화하세요.

# 라이선스 키 저장 키 이름 (브라우저 localStorage 키)
# V1: rest_hotel_license  /  V2: rest_hotel_license_v2
VITE_LICENSE_STORAGE_KEY=rest_hotel_license_v2

# ──────────────────────────────────────────────────────────
# [B] 서버용 환경변수 (스마트 락커 백엔드 사용 시만 필요)
# ──────────────────────────────────────────────────────────
# ※ 일반 매장 운영(Netlify PWA)에는 아래 변수가 필요 없습니다.
# ※ 스마트 락커 하드웨어 연동을 쓸 때만 설정하세요.

# PostgreSQL 데이터베이스 연결 문자열
# 예: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 스마트 락커 관리자 API 인증 키
# 하드웨어 컨트롤러 등록, 기기 관리 API 호출 시 사용
# 개발 환경 기본값: equus-admin-2025 (코드에 하드코딩)
ADMIN_KEY=

# ──────────────────────────────────────────────────────────
# [C] 라이선스 시크릿에 대해
# ──────────────────────────────────────────────────────────
# 라이선스 서명 비밀키는 환경변수가 아닙니다.
# client/src/lib/licenseValidation.ts 파일 내부에
# 난독화된 형태로 하드코딩되어 있습니다.
# license-generator.html 도구에도 동일한 값이 포함됩니다.
# → 외부에 공개하거나 Git에 올리면 라이선스 위조 위험이 있습니다.
